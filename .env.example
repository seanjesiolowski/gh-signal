# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Local Postgres password used by docker-compose. Set a strong value, e.g.
# generated with: openssl rand -hex 16  (Postgres rejects an empty password.)
POSTGRES_PASSWORD=

# Connection string the app reads (required — no default is baked into the code).
# Docker Compose builds this per-service from POSTGRES_PASSWORD above; set it here
# for native local runs, replacing <password> with the same value.
DATABASE_URL=postgresql://postgres:<password>@localhost:5433/github_events

# GitHub personal access token (classic, public_repo scope) for the ingestor and
# enricher. Without it, GitHub API calls are capped at 60/hour per IP.
GITHUB_TOKEN=
